# Hawk OS GS8 Plymouth theme
# Place this folder at /usr/share/plymouth/themes/hawk-os-gs8/

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

logo_image = Image("hawk-logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX((screen_width - logo_image.GetWidth()) / 2);
logo_sprite.SetY((screen_height - logo_image.GetHeight()) / 2 - 45);
logo_sprite.SetZ(10);

spinner_images = [];
spinner_sprites = [];
for (i = 0; i < 12; i++) {
    filename = "spinner-" + (i < 10 ? "0" : "") + i + ".png";
    spinner_images[i] = Image(filename);
    spinner_sprites[i] = Sprite(spinner_images[i]);
    spinner_sprites[i].SetX((screen_width - 96) / 2);
    spinner_sprites[i].SetY((screen_height / 2) + 165);
    spinner_sprites[i].SetZ(20);
    spinner_sprites[i].SetOpacity(0);
}

current_frame = 0;
last_frame_time = 0;

fun refresh_callback() {
    now = Plymouth.GetTime();
    if (now - last_frame_time > 0.08) {
        spinner_sprites[current_frame].SetOpacity(0);
        current_frame = (current_frame + 1) % 12;
        spinner_sprites[current_frame].SetOpacity(1);
        last_frame_time = now;
    }
}

spinner_sprites[0].SetOpacity(1);
Plymouth.SetRefreshFunction(refresh_callback);
